# Copy to .env. A variable already set in the process is left as it is.
# A missing .env is fine; the service then uses the environment.

# OpenWeatherMap API key. Required for temperatures.
OWM_KEY=

# US ZIP code for current conditions and the 5-day forecast.
OWM_ZIP=

# Address the HTTP server binds. Empty means :8080.
LISTEN=:8080
